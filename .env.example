# Password for the /admin dashboard
ADMIN_PASSWORD=susubox123
# Any long random string, used to sign the admin login cookie
SESSION_SECRET=change-me-to-a-long-random-string

# ── Needed on Vercel (optional locally) ──────────────────────────────
# Cloudinary: stores uploaded images, videos and ID documents.
# Find these on your Cloudinary dashboard (https://console.cloudinary.com).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upstash Redis: stores news, videos, applications and team photo links.
# Vercel fills these in automatically when you add Upstash for Redis under Storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Payments & SMS (optional; the site works without them) ───────────
# Paystack: Dashboard → Settings → API Keys & Webhooks. Use sk_test_… while testing.
# Also set the webhook URL there to https://<your-site>/api/paystack/webhook
PAYSTACK_SECRET_KEY=
# Domain for the placeholder email Paystack requires when a customer has no email
PAYMENT_EMAIL_DOMAIN=

# mNotify: Dashboard → API → API key. The sender ID must be registered and approved
# on your mNotify account (max 11 characters). Without a key, SMS are only logged.
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=SUSUBOX
# Optional: a staff phone number that gets an SMS for every new application
ADMIN_SMS_PHONE=

# Optional: the public site URL used in SMS links (worked out automatically if empty)
SITE_URL=

# Cloudflare Turnstile CAPTCHA (optional): Cloudflare dashboard → Turnstile → Add widget.
# Add your site's domain (and "localhost" for testing) to the widget's hostnames.
# Test keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
