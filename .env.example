# Password for the /admin dashboard
ADMIN_PASSWORD=susubox123
# Any long random string, used to sign the admin login cookie
SESSION_SECRET=change-me-to-a-long-random-string

# ── Needed on Vercel (optional locally) ──────────────────────────────
# Cloudinary: stores uploaded images, videos and ID documents.
# Find these on your Cloudinary dashboard (https://console.cloudinary.com).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upstash Redis: stores news, videos, applications and team photo links.
# Vercel fills these in automatically when you add Upstash for Redis under Storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=
